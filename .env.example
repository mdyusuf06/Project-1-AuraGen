# ==============================================================================
# AuraGen Monorepo Environment Variables Example
# ==============================================================================

# --- Backend (WebSocket Server & Code-Gen) ---
WS_PORT=8080
COGNITIVE_LOAD_THRESHOLD=70
GENERATION_COOLDOWN_MS=3000

# Optional: Set to true if teammate's LangChain generateComponent module is linked
USE_TEAMMATE_CODEGEN=false
OPENAI_API_KEY=your_openai_api_key_here

# --- Frontend (Next.js App) ---
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_COGNITIVE_LOAD_THRESHOLD=70

