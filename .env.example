# ==============================================================================
# AuraGen Monorepo Environment Variables Example
# ==============================================================================

# --- Backend (WebSocket Server & Code-Gen) ---
WS_PORT=8080
COGNITIVE_LOAD_THRESHOLD=70
GENERATION_COOLDOWN_MS=3000

# Enable the LangChain wizard provider in backend/.env
USE_TEAMMATE_CODEGEN=false
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o
OPENAI_TEMPERATURE=0.2
REQUEST_TIMEOUT_MS=24000
# WS_HOST=127.0.0.1
# WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Next.js App) ---
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_COGNITIVE_LOAD_THRESHOLD=70

